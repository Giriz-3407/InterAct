# MongoDB Connection URI (Atlas connection string or local mongodb)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=interact

# Allowed CORS origins in JSON-array format
CORS_ORIGINS=["http://localhost:5173", "https://your-frontend.vercel.app"]

# Server Port
PORT=8000

# GitHub Repository for Agent downloads (format: owner/repo)
GITHUB_REPO=Giriz-3407/InterAct-Agent
